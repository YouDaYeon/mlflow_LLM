MLFLOW_TRACKING_URI=http://127.0.0.1:2522

# Report DB — 로컬 백엔드(uvicorn on host)
DATABASE_URL=postgresql+psycopg:
# Docker compose backend 컨테이너에서만:
# DATABASE_URL=postgresql+psycopg:

# pgAdmin (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@
PGADMIN_DEFAULT_PASSWORD=

LLAMA_BASE_URL=http://
LLAMA_API_KEY=
LLAMA_MODEL=
LLAMA_TEMPERATURE=

CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
CHAT_TEMPERATURE=
CHAT_HISTORY_LIMIT=6

# Frontend -> backend
# Docker compose: http://backend:8010
# 로컬 Streamlit + uvicorn(8011): http://localhost:8011
API_BASE_URL=http://backend:8010
# 프론트엔드의 "MLflow에서 실험 보기" 링크 (사용자 브라우저에서 접속 가능한 서버 주소)
MLFLOW_UI_URL=http://localhost:2522

